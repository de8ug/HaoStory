    }
  },
  "languages": ["zh-CN", "en"],
  "brand": {
    "name": "",
    "name_zh": "",
    "website": "",
    "cta_en": "",
    "cta_zh": ""
  },
  "commercial_note": {
    "enabled": false,
    "en": "The core workflow is open source. Private integrations, tailored workflows, and implementation partnerships may be offered separately.",
    "zh-CN": "核心工作流保持开源；私有系统集成、定制工作流与落地合作可另行提供。"
  },
  "capture": {
    "mode": "off",
    "auto_start": false,
    "auto_checkpoint": [
      "decision",
      "scope_change",
      "failure",
      "recovery",
      "before_after",
      "milestone",
      "demo",
      "metric",
      "external_signal"
    ],
    "auto_finish_on_handoff": true,
    "require_notice": true,
    "assets_require_confirmation": false,
    "max_events_per_phase": 4
  },
  "visual_capture": {
    "enabled": true,
    "mode": "when-enabled",
    "capture_events": ["failure", "recovery", "before_after", "milestone", "demo"],
    "store_directly_in_assets": true,
    "wait_for_stable_view": true,
    "recapture_invalid_frames": true,
    "production_requires_request": true,
    "prompt_on_phase_close": true,
    "final_content_review_required": true
  },
  "story_memory": {
    "enabled": true,
    "registry": ".haostory/story-registry.json",
    "require_new_claim_or_evidence": true,
    "max_context_ratio_short": 0.15,
    "max_context_ratio_long": 0.1
  },
  "project_history": {
    "enabled": false,
    "directory": "docs",
    "progress_file": "docs/progress.md",
    "screenshots_directory": "docs/screenshots",
    "requires_stage_confirmation": true,
    "auto_commit": false,
    "auto_push": false,
    "auto_upload": false
  }
}
